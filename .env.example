# quotaguard configuration. Copy to .env and replace the dummy values.
# Mirrors the environment table in docs/architecture.md.

# Required. Redis 7.x connection URL holding all admission state.
REDIS_URL=redis://localhost:6379/0

# Required. Sent as X-Admin-Token on /admin/* and /v1/usage routes.
QG_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# SQLAlchemy URL for plans, keys, rollups, and the webhook outbox.
DATABASE_URL=sqlite:///./data/quotaguard.db

# When set, POST /v1/check requires this value as X-Service-Token.
# QG_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Socket and connect timeout applied to every Redis command, in milliseconds.
REDIS_TIMEOUT_MS=100

# How long a resolved api key stays in the in-process cache.
KEY_CACHE_TTL_SECONDS=5

# Rollup loop period in seconds; 0 disables the loop.
ROLLUP_INTERVAL_SECONDS=300

# Per-attempt webhook POST timeout and attempt cap before the row is parked.
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5

# When set, webhook bodies are signed as X-QuotaGuard-Signature: sha256=<hmac>.
# QG_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Structured logger level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
